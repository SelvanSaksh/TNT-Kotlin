# Copy to keystore.properties at the project root and fill in your upload keystore paths.
# Generate a keystore (one-time):
#   keytool -genkey -v -keystore ratifye-upload.keystore -alias ratifye -keyalg RSA -keysize 2048 -validity 10000
storeFile=ratifye-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=ratifye
keyPassword=YOUR_KEY_PASSWORD
